# Packages written by scripts/package.ps1 and scripts/package.sh
/dist/

# Temporary files, kept out of the repository
/tmp/

# Output of the list_host_information scripts (the .bat default and the README examples)
host_information.*

# Output of the list_installed_software scripts (the .bat default and the README examples)
installed_software.*

# Output of the list_executables scripts (the README examples), by format,
# so source files such as src/go/executables.go aren't ignored
executables.txt
executables.csv
executables.json
executables.html
